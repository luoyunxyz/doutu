# ============================================================================
#  短视频去水印平台 · 服务端环境变量
#  复制成 .env 后修改；生产环境必须 chmod 600 .env
#  .env 位于站点根目录之外，Nginx 层另有 deny 规则兜底
# ============================================================================

# ---------- 运行 ----------
NODE_ENV=production
BIND_HOST=127.0.0.1
PORT=7101
LOG_LEVEL=info
LOG_DIR=./logs

# ---------- 数据库 ----------
# sqlite = 本地开发/单机演示（零依赖，使用 Node 内置 node:sqlite）
# mysql  = 生产（MySQL 8.0，utf8mb4）
DB_DIALECT=sqlite
SQLITE_FILE=./data/doutu.db
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=doutu
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=doutu
MYSQL_POOL=10

# ---------- Redis（留空 = 进程内内存实现，单机首期够用） ----------
# 形如 redis://:password@127.0.0.1:6379/0
REDIS_URL=

# ---------- 安全 ----------
# MASTER_KEY：换发会话级动态密钥的根密钥，必须与客户端 so 内嵌值对应
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=please_replace_with_64_hex_chars
SIGN_WINDOW_SEC=300
SESSION_TTL_HOURS=24
# 后台入口路径（改成不可猜的路径能挡掉大部分扫描；改完要同步改 Nginx location）
ADMIN_PATH=/admin
ADMIN_TOKEN_TTL_MIN=120
ADMIN_IDLE_TIMEOUT_MIN=30
# 卡密激活失败锁定：同 IP 1 小时内失败 N 次封禁 M 分钟
ACTIVATE_FAIL_LIMIT=20
ACTIVATE_LOCK_MINUTES=60
# 兼容策略：允许该版本号以下的旧客户端请求（0 = 不限制）
MIN_SUPPORTED_VERSION_CODE=0

# ---------- 存储 ----------
# local = 本机磁盘 + 签名 URL；oss = 阿里云 OSS 私有桶 + 签名 URL
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/media
# 对外下载前缀：只写到域名，不要带 /dw（代码自己会拼 /dw/file/{key}）
STORAGE_PUBLIC_BASE=https://api.example.com
URL_TTL_SEC=900
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ---------- 媒体处理 ----------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# 大容量分区，务必定时清理（见 deploy/crontab.txt）
TMPDIR=./storage/tmp
WORKER_CONCURRENCY=3
TASK_TIMEOUT_SEC=120
WORKER_POLL_MS=1000
# 中文水印字体：Linux 装 fonts-wqy-zenhei，Windows 用 msyh.ttc
# 不配置字体时水印中文会渲染成方块
WATERMARK_FONT=
WATERMARK_OPACITY=0.42
WATERMARK_WIDTH_RATIO=0.20
WATERMARK_POSITION=bottom-right

# ---------- 解析引擎 ----------
# 自研线路：name/shuiyin 的 media-parser（Flask，默认 8051）
MEDIA_PARSER_BASE=http://127.0.0.1:8051
MEDIA_PARSER_KEY=
MEDIA_PARSER_TIMEOUT_MS=20000
# 原片缓存时长（小时），同 item_id 命中则复用
ORIGIN_CACHE_HOURS=24
# 线路成功率告警阈值
ROUTE_SUCC_ALERT=0.8

# ---------- 支付（易支付 / 彩虹易支付） ----------
PAY_PROVIDER=mock
EPAY_GATEWAY=https://pay.example.com
EPAY_PID=1000
EPAY_KEY=change_me
EPAY_NOTIFY_BASE=https://api.example.com

# ---------- 备份 ----------
BACKUP_DIR=./backup
BACKUP_RETAIN_DAYS=7
BACKUP_RETAIN_REMOTE_DAYS=30
# 备份加密口令：优先用下面的口令文件（chmod 600，且不进版本库）
BACKUP_PASS_FILE=
BACKUP_PASSWORD=
MYSQLDUMP_PATH=mysqldump

# ---------- 告警 ----------
# 钉钉/企业微信机器人 webhook，留空则只写日志
ALERT_WEBHOOK=
