package com.example.doutu.features.zhi;

import android.app.Activity;
import android.app.AlertDialog;
import android.content.Intent;
import android.graphics.Canvas;
import android.graphics.Color;
import android.os.Build;
import android.os.Bundle;
import android.view.MotionEvent;
import android.view.View;
import android.view.Window;
import android.view.WindowInsetsController;
import android.view.WindowManager;
import android.widget.EditText;
import android.widget.Toast;

import com.example.doutu.features.zhi.data.BillStore;
import com.example.doutu.features.zhi.ui.BillAnalyticsScreen;

import java.util.List;

/**
 * Hosts the "收支统计" (Income/Expense Statistics) page reached from the 账单 list''s "收支分析" button.
 *
 * <p>The page shows a donut chart of spending/income categories with editable amounts,
 * auto-synced to the current date. Tapping a category row lets the user edit its amount,
 * and the chart recalculates automatically.
 */
public final class BillAnalyticsActivity extends Activity {
    private static final float TOUCH_SLOP = 8f;

    private final BillAnalyticsScreen screen = new BillAnalyticsScreen();
    private final BillAnalyticsScreen.State state = new BillAnalyticsScreen.State();
    private PageView view;

    private float downY;
    private float lastY;
    private boolean moved;

    public static Intent intentFor(Activity activity) {
        Intent intent = new Intent(activity, BillAnalyticsActivity.class);
        intent.addFlags(Intent.FLAG_ACTIVITY_REORDER_TO_FRONT | Intent.FLAG_ACTIVITY_SINGLE_TOP);
        return intent;
    }

    @Override
    protected void onCreate(Bundle bundle) {
        super.onCreate(bundle);
        requestWindowFeature(Window.FEATURE_NO_TITLE);
        screen.load(getResources());
        view = new PageView();
        setContentView(view);
        configureWindow(getWindow());
    }

    @Override
    public void onWindowFocusChanged(boolean focus) {
        super.onWindowFocusChanged(focus);
        if (focus) configureWindow(getWindow());
    }

    @Override
    protected void onResume() {
        super.onResume();
        BillStore.generate();
        view.invalidate();
    }

    private void configureWindow(Window window) {
        window.clearFlags(WindowManager.LayoutParams.FLAG_TRANSLUCENT_STATUS
                | WindowManager.LayoutParams.FLAG_TRANSLUCENT_NAVIGATION);
        window.addFlags(WindowManager.LayoutParams.FLAG_DRAWS_SYSTEM_BAR_BACKGROUNDS
                | WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN
                | WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS);
        window.setStatusBarColor(Color.TRANSPARENT);
        window.setNavigationBarColor(Color.TRANSPARENT);
        if (Build.VERSION.SDK_INT >= 29) {
            window.setStatusBarContrastEnforced(false);
            window.setNavigationBarContrastEnforced(false);
        }
        if (Build.VERSION.SDK_INT >= 28) {
            window.getAttributes().layoutInDisplayCutoutMode =
                    WindowManager.LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_SHORT_EDGES;
        }
        if (Build.VERSION.SDK_INT >= 30) {
            window.setDecorFitsSystemWindows(false);
            WindowInsetsController controller = window.getInsetsController();
            if (controller != null) {
                controller.setSystemBarsAppearance(
                        WindowInsetsController.APPEARANCE_LIGHT_NAVIGATION_BARS
                                | WindowInsetsController.APPEARANCE_LIGHT_STATUS_BARS,
                        WindowInsetsController.APPEARANCE_LIGHT_NAVIGATION_BARS
                                | WindowInsetsController.APPEARANCE_LIGHT_STATUS_BARS);
            }
        } else {
            window.getDecorView().setSystemUiVisibility(
                    View.SYSTEM_UI_FLAG_LAYOUT_STABLE | View.SYSTEM_UI_FLAG_LAYOUT_FULLSCREEN
                            | View.SYSTEM_UI_FLAG_LAYOUT_HIDE_NAVIGATION
                            | View.SYSTEM_UI_FLAG_LIGHT_NAVIGATION_BAR
                            | View.SYSTEM_UI_FLAG_LIGHT_STATUS_BAR);
        }
    }

    @Override
    public void finish() {
        super.finish();
        overridePendingTransition(0, 0);
    }

    // ── Acting ────────────────────────────────────────────────────────────

    private void act(String token) {
        if (token == null || token.equals("noop")) return;
        if (token.equals("back")) {
            finish();
            return;
        }
        if (token.equals("toggle")) {
            state.income = !state.income;
            state.overrides.clear();
            view.invalidate();
            return;
        }
        if (token.startsWith("tab:")) {
            int t = Integer.parseInt(token.substring(4));
            // Only 0 (月) or 1 (年) are valid
            state.tab = Math.max(0, Math.min(1, t));
            state.overrides.clear();
            state.scroll = 0f;
            view.invalidate();
            return;
        }
        if (token.startsWith("edit:")) {
            int idx = Integer.parseInt(token.substring(5));
            editCategory(idx);
            return;
        }
    }

    private void editCategory(int index) {
        List<BillAnalyticsScreen.Slice> slices = screen.currentSlices(state);
        if (index < 0 || index >= slices.size()) return;

        BillAnalyticsScreen.Slice slice = slices.get(index);
        double current = state.overrides.containsKey(index)
                ? state.overrides.get(index)
                : slice.amount;

        final EditText input = new EditText(this);
        input.setHint("输入新的金额");
        input.setText(String.format(java.util.Locale.US, "%.2f", current));
        input.selectAll();

        new AlertDialog.Builder(this)
                .setTitle("修改 " + slice.name + " 金额")
                .setView(input)
                .setNegativeButton("取消", null)
                .setNeutralButton("重置", (d, w) -> {
                    state.overrides.remove(index);
                    view.invalidate();
                })
                .setPositiveButton("保存", (d, w) -> {
                    try {
                        double v = Double.parseDouble(input.getText().toString());
                        state.overrides.put(index, Math.abs(v));
                        view.invalidate();
                    } catch (Exception ignored) {
                        Toast.makeText(this, "请输入有效金额", Toast.LENGTH_SHORT).show();
                    }
                })
                .show();
    }

    private void scrollPageTo(float target) {
        state.scroll = Math.max(0f, Math.min(screen.maxScroll(state), target));
        view.invalidate();
    }

    // ── PageView ──────────────────────────────────────────────────────────

    private final class PageView extends View {
        PageView() {
            super(BillAnalyticsActivity.this);
            setFocusable(true);
        }

        @Override
        protected void onDraw(Canvas canvas) {
            canvas.save();
            canvas.scale(getWidth() / BillAnalyticsScreen.W, getHeight() / BillAnalyticsScreen.H);
            screen.draw(canvas, state);
            canvas.restore();
        }

        @Override
        public boolean onTouchEvent(MotionEvent event) {
            float x = event.getX() * BillAnalyticsScreen.W / Math.max(1, getWidth());
            float y = event.getY() * BillAnalyticsScreen.H / Math.max(1, getHeight());
            switch (event.getActionMasked()) {
                case MotionEvent.ACTION_DOWN:
                    downY = y;
                    lastY = y;
                    moved = false;
                    return true;
                case MotionEvent.ACTION_MOVE:
                    if (!moved && Math.abs(y - downY) > TOUCH_SLOP) moved = true;
                    if (moved) scrollPageTo(state.scroll + (lastY - y));
                    lastY = y;
                    return true;
                case MotionEvent.ACTION_UP:
                case MotionEvent.ACTION_CANCEL:
                    if (!moved) act(screen.hitTest(state, x, y));
                    return true;
                default:
                    return true;
            }
        }

        @Override
        public boolean performClick() {
            super.performClick();
            return true;
        }
    }
}


